# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Server-only secret. Never prefix this with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Set a long, random value before deployment
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
# Challenge-provided reviewer credentials; you can override them here
ADMIN_EMAIL=admin@embrione.pes.edu
ADMIN_PASSWORD=EmbrioneAdmin@2026
